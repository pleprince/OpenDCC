set(DEPS_PATCH_DIR "${CMAKE_CURRENT_LIST_DIR}/../../tools/deps/patches")

# ----------------------------------------------------------------------------------------------------------
# lock: sha256 pins for every source/headers download
#
# Pins live in global properties (DEPS_LOCK_<KEY>_URL / _URL256) so any helper can record a new one without
# threading scopes; DEPS_LOCK_DIRTY says whether deps/<platform>.lock.cmake has to be rewritten.

function(opendcc_deps_lock_load lock_file)
    set(DEPS_LOCK_SCHEMA 1)
    if(EXISTS "${lock_file}")
        # include() shares this scope, so the pins land in the variables read below.
        include("${lock_file}")
    endif()
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_key(_key "${_name}")
        set_property(GLOBAL PROPERTY "DEPS_LOCK_${_key}_URL" "${DEPS_LOCK_${_key}_URL}")
        set_property(GLOBAL PROPERTY "DEPS_LOCK_${_key}_SHA256" "${DEPS_LOCK_${_key}_SHA256}")
    endforeach()
    set_property(GLOBAL PROPERTY "DEPS_LOCK_OCIO_CONFIG_URL" "${DEPS_LOCK_OCIO_CONFIG_URL}")
    set_property(GLOBAL PROPERTY "DEPS_LOCK_OCIO_CONFIG_SHA256" "${DEPS_LOCK_OCIO_CONFIG_SHA256}")
    set_property(GLOBAL PROPERTY DEPS_LOCK_DIRTY OFF)
endfunction()

function(opendcc_deps_lock_get out_url out_sha name)
    opendcc_deps_key(_key "${name}")
    get_property(_url GLOBAL PROPERTY "DEPS_LOCK_${_key}_URL")
    get_property(_sha GLOBAL PROPERTY "DEPS_LOCK_${_key}_SHA256")
    set(${out_url} "${_url}" PARENT_SCOPE)
    set(${out_sha} "${_sha}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_lock_remember name url sha)
    opendcc_deps_key(_key "${name}")
    set_property(GLOBAL PROPERTY "DEPS_LOCK_${_key}_URL" "${url}")
    set_property(GLOBAL PROPERTY "DEPS_LOCK_${_key}_SHA256" "${sha}")
    set_property(GLOBAL PROPERTY DEPS_LOCK_DIRTY ON)
endfunction()

# Deterministic lock text: sorted by dependency name, one URL and one SHA256 per line.
function(opendcc_deps_lock_text out)
    set(_names "")
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_decl(_provider "${_name}" PROVIDER)
        if("${_provider}" STREQUAL "source" OR "${_provider}" STREQUAL "headers")
            opendcc_deps_list_append(_names "${_name}")
        endif()
    endforeach()
    opendcc_deps_list_append(_names "ocio-config")
    list(SORT _names)

    set(_text "set(DEPS_LOCK_SCHEMA 1)\n")
    foreach(_name IN LISTS _names)
        opendcc_deps_key(_key "${_name}")
        opendcc_deps_lock_get(_url _sha "${_name}")
        opendcc_deps_quote(_url_text "${_url}")
        opendcc_deps_quote(_sha_text "${_sha}")
        string(APPEND _text "set(DEPS_LOCK_${_key}_URL ${_url_text})\n")
        string(APPEND _text "set(DEPS_LOCK_${_key}_SHA256 ${_sha_text})\n")
    endforeach()
    set(${out} "${_text}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_lock_save lock_file)
    opendcc_deps_lock_text(_text)
    file(WRITE "${lock_file}.tmp" "${_text}")
    file(RENAME "${lock_file}.tmp" "${lock_file}")
endfunction()

# ----------------------------------------------------------------------------------------------------------
# archives

# A file name that keeps the archive type: codeload URLs end in a tag, not in an extension.
function(opendcc_deps_archive_name out url)
    set(_path "${url}")
    string(FIND "${_path}" "?" _cut)
    if(_cut GREATER -1)
        string(SUBSTRING "${_path}" 0 ${_cut} _path)
    endif()
    string(FIND "${_path}" "#" _cut)
    if(_cut GREATER -1)
        string(SUBSTRING "${_path}" 0 ${_cut} _path)
    endif()
    get_filename_component(_base "${_path}" NAME)
    if("${_base}" STREQUAL "")
        set(_base "archive")
    endif()
    if(NOT "${_base}" MATCHES "\\.(tar\\.gz|tgz|tar\\.xz|txz|tar\\.bz2|zip|tar)$")
        if("${url}" MATCHES "/tar\\.gz/")
            set(_base "${_base}.tar.gz")
        elseif("${url}" MATCHES "/tar\\.xz/")
            set(_base "${_base}.tar.xz")
        elseif("${url}" MATCHES "/zip/")
            set(_base "${_base}.zip")
        else()
            set(_base "${_base}.tar.gz")
        endif()
    endif()
    set(${out} "${_base}" PARENT_SCOPE)
endfunction()

# Fetch a pinned artifact into <prefix>/downloads and record URL+SHA in the lock whenever they differ from what
# is recorded. OPENDCC_DEPS_UPDATE_LOCK=1 re-hashes existing downloads instead of trusting them.
function(opendcc_deps_download)
    cmake_parse_arguments(PARSE_ARGV 0 arg "REHASH" "NAME;URL;SHA256;OUT_PATH;OUT_SHA" "")
    if(arg_UNPARSED_ARGUMENTS)
        opendcc_deps_die("internal error: opendcc_deps_download got \"${arg_UNPARSED_ARGUMENTS}\"")
    endif()
    set(_name "${arg_NAME}")
    set(_url "${arg_URL}")
    opendcc_deps_archive_name(_archive "${_url}")
    set(_target "${DEPS_PREFIX}/downloads/${_archive}")

    opendcc_deps_lock_get(_locked_url _locked_sha "${_name}")
    if(NOT "${_locked_url}" STREQUAL "" AND NOT "${_locked_url}" STREQUAL "${_url}")
        # The spec now points at a different artifact (a version bump), so the recorded hash belongs to the
        # previous one and cannot be checked against it. Same-URL bytes that changed are still caught below.
        set(_locked_url "")
        set(_locked_sha "")
    endif()
    set(_pinned "${arg_SHA256}")
    if("${_pinned}" STREQUAL "")
        set(_pinned "${_locked_sha}")
    endif()

    if(EXISTS "${_target}" AND NOT arg_REHASH AND NOT "${_pinned}" STREQUAL "")
        opendcc_deps_sha256_file(_digest "${_target}")
        if("${_digest}" STREQUAL "${_pinned}")
            set(${arg_OUT_PATH} "${_target}" PARENT_SCOPE)
            set(${arg_OUT_SHA} "${_digest}" PARENT_SCOPE)
            return()
        endif()
    endif()

    if(NOT EXISTS "${_target}")
        message(STATUS "  ${_name}: downloading ${_url}")
        file(MAKE_DIRECTORY "${DEPS_PREFIX}/downloads")
        set(_partial "${_target}.part")
        file(REMOVE "${_partial}")
        set(_downloaded OFF)
        foreach(_attempt RANGE 1 3)
            file(DOWNLOAD "${_url}" "${_partial}" TLS_VERIFY ON STATUS _status)
            list(GET _status 0 _status_code)
            if(_status_code EQUAL 0)
                set(_downloaded ON)
                break()
            endif()
            file(REMOVE "${_partial}")
        endforeach()
        if(NOT _downloaded)
            # Middleboxes defeat file(DOWNLOAD)'s TLS stack but not curl's, or the other way round; the explicit
            # curl call is the fallback.
            execute_process(
                COMMAND curl --fail --location --retry 3 --silent --show-error --output "${_partial}" "${_url}"
                RESULT_VARIABLE _curl_code ERROR_QUIET)
            if(NOT _curl_code EQUAL 0)
                file(REMOVE "${_partial}")
                opendcc_deps_die("downloading ${_url} failed (cmake: ${_status}, curl: ${_curl_code})")
            endif()
        endif()
        opendcc_deps_sha256_file(_digest "${_partial}")
        if(NOT "${_pinned}" STREQUAL "" AND NOT "${_digest}" STREQUAL "${_pinned}")
            file(REMOVE "${_partial}")
            if("${arg_SHA256}" STREQUAL "")
                set(_pin_source "lock")
            else()
                set(_pin_source "spec")
            endif()
            opendcc_deps_die("sha256 mismatch for ${_name}: pinned ${_pinned}, download is ${_digest} "
                             "(${_pin_source}). If the upstream tag was re-cut, drop the SHA256 pin from the spec "
                             "and re-run with OPENDCC_DEPS_UPDATE_LOCK=1")
        endif()
        file(RENAME "${_partial}" "${_target}")
    endif()

    opendcc_deps_sha256_file(_digest "${_target}")
    if(NOT "${_pinned}" STREQUAL "" AND NOT "${_digest}" STREQUAL "${_pinned}")
        opendcc_deps_rel(_where "${_target}")
        opendcc_deps_die("sha256 mismatch for ${_name}: pinned ${_pinned}, ${_where} is ${_digest}")
    endif()
    if(NOT "${_digest}" STREQUAL "${_locked_sha}" OR NOT "${_url}" STREQUAL "${_locked_url}")
        message(STATUS "  ${_name}: recorded sha256 ${_digest} for ${_name}")
        opendcc_deps_lock_remember("${_name}" "${_url}" "${_digest}")
    endif()
    set(${arg_OUT_PATH} "${_target}" PARENT_SCOPE)
    set(${arg_OUT_SHA} "${_digest}" PARENT_SCOPE)
endfunction()

# Extract an archive and, when strip is on, drop its single top-level directory. file(ARCHIVE_EXTRACT) cannot
# report a failure without aborting the configure, so the same libarchive backend is driven through
# `cmake -E tar`, with the system tar as the fallback, and both report an exit code.
function(opendcc_deps_extract archive destination strip)
    set(_work "${destination}.extract")
    file(REMOVE_RECURSE "${_work}")
    file(MAKE_DIRECTORY "${_work}")
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
        WORKING_DIRECTORY "${_work}"
        RESULT_VARIABLE _cmake_tar
        OUTPUT_QUIET
        ERROR_QUIET)
    if(NOT _cmake_tar EQUAL 0)
        execute_process(
            COMMAND tar -xf "${archive}"
            WORKING_DIRECTORY "${_work}"
            RESULT_VARIABLE _system_tar
            OUTPUT_QUIET
            ERROR_QUIET)
        if(NOT _system_tar EQUAL 0)
            file(REMOVE_RECURSE "${_work}")
            opendcc_deps_die("cannot extract ${archive} (cmake -E tar: ${_cmake_tar}, tar: ${_system_tar})")
        endif()
    endif()

    set(_source "${_work}")
    if(strip)
        file(GLOB _entries LIST_DIRECTORIES true "${_work}/*" "${_work}/.[!.]*")
        list(LENGTH _entries _count)
        if(NOT _count EQUAL 1 OR NOT IS_DIRECTORY "${_entries}")
            file(REMOVE_RECURSE "${_work}")
            opendcc_deps_die("${archive}: expected exactly one top-level directory")
        endif()
        set(_source "${_entries}")
    endif()

    file(REMOVE_RECURSE "${destination}")
    get_filename_component(_parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    file(RENAME "${_source}" "${destination}")
    file(REMOVE_RECURSE "${_work}")
endfunction()

function(opendcc_deps_patch_digests out patches)
    set(_digests "")
    foreach(_patch IN LISTS patches)
        set(_path "${DEPS_PATCH_DIR}/${_patch}")
        if(NOT EXISTS "${_path}")
            opendcc_deps_die("patch ${_patch} is missing from ${DEPS_PATCH_DIR}")
        endif()
        opendcc_deps_sha256_file(_sha "${_path}")
        opendcc_deps_list_append(_digests "${_patch}=${_sha}")
    endforeach()
    set(${out} "${_digests}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_apply_patches name patches src)
    foreach(_patch IN LISTS patches)
        set(_path "${DEPS_PATCH_DIR}/${_patch}")
        if(NOT EXISTS "${_path}")
            opendcc_deps_die("patch ${_patch} is missing from ${DEPS_PATCH_DIR}")
        endif()
        message(STATUS "  ${name}: applying ${_patch}")
        execute_process(
            COMMAND "${DEPS_PATCH_TOOL}" -p1 --forward --batch --silent -d "${src}" -i "${_path}"
            OUTPUT_VARIABLE _stdout
            ERROR_VARIABLE _stderr
            RESULT_VARIABLE _code)
        if(NOT _code EQUAL 0)
            opendcc_deps_die("${name}: ${_patch} did not apply cleanly; the archive or the patch changed:\n"
                             "${_stdout}${_stderr}")
        endif()
    endforeach()
endfunction()

# ----------------------------------------------------------------------------------------------------------
# stamps

function(opendcc_deps_stamp_path out name)
    set(${out} "${DEPS_PREFIX}/stamps/${name}.cmake" PARENT_SCOPE)
endfunction()

function(opendcc_deps_read_stamp out_version out_sha name)
    set(DEPS_STAMP_VERSION "")
    set(DEPS_STAMP_OPTIONS_SHA256 "")
    set(DEPS_STAMP_INSTALLED_AT "")
    opendcc_deps_stamp_path(_path "${name}")
    if(EXISTS "${_path}")
        include("${_path}")
    endif()
    set(${out_version} "${DEPS_STAMP_VERSION}" PARENT_SCOPE)
    set(${out_sha} "${DEPS_STAMP_OPTIONS_SHA256}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_write_stamp name version digest)
    opendcc_deps_stamp_path(_path "${name}")
    get_filename_component(_directory "${_path}" DIRECTORY)
    file(MAKE_DIRECTORY "${_directory}")
    string(TIMESTAMP _now "%Y-%m-%dT%H:%M:%SZ" UTC)
    opendcc_deps_quote(_version_text "${version}")
    opendcc_deps_quote(_digest_text "${digest}")
    opendcc_deps_quote(_now_text "${_now}")
    string(CONCAT _body "set(DEPS_STAMP_VERSION ${_version_text})\n" "set(DEPS_STAMP_OPTIONS_SHA256 ${_digest_text})\n"
                         "set(DEPS_STAMP_INSTALLED_AT ${_now_text})\n")
    file(WRITE "${_path}.tmp" "${_body}")
    file(RENAME "${_path}.tmp" "${_path}")
endfunction()

# ----------------------------------------------------------------------------------------------------------
# JSON, for the recipe plan and --print-config

function(opendcc_deps_json_quote out value)
    string(REPLACE "\\" "\\\\" _text "${value}")
    string(REPLACE "\"" "\\\"" _text "${_text}")
    string(REPLACE "\n" "\\n" _text "${_text}")
    string(REPLACE "\r" "\\r" _text "${_text}")
    string(REPLACE "\t" "\\t" _text "${_text}")
    set(${out} "\"${_text}\"" PARENT_SCOPE)
endfunction()

function(opendcc_deps_json_bool out value)
    if(value)
        set(${out} "true" PARENT_SCOPE)
    else()
        set(${out} "false" PARENT_SCOPE)
    endif()
endfunction()

function(opendcc_deps_json_array_from_list out list_var)
    set(_text "[")
    set(_first ON)
    foreach(_item IN LISTS ${list_var})
        if(_first)
            set(_first OFF)
        else()
            string(APPEND _text ", ")
        endif()
        opendcc_deps_json_quote(_quoted "${_item}")
        string(APPEND _text "${_quoted}")
    endforeach()
    string(APPEND _text "]")
    set(${out} "${_text}" PARENT_SCOPE)
endfunction()

# Append one "key": value pair to an object body being built by hand; <first_var> tracks the leading comma.
function(opendcc_deps_json_field body_var first_var key json)
    set(_body "${${body_var}}")
    if(NOT ${first_var})
        string(APPEND _body ", ")
    endif()
    opendcc_deps_json_quote(_key "${key}")
    string(APPEND _body "${_key}: ${json}")
    set(${body_var} "${_body}" PARENT_SCOPE)
    set(${first_var} OFF PARENT_SCOPE)
endfunction()

# Drop the parallel job count: it changes the build speed, never the build output.
function(opendcc_deps_normalise_argv out argv_var)
    set(_result "")
    set(_skip_next OFF)
    foreach(_argument IN LISTS ${argv_var})
        if(_skip_next)
            set(_skip_next OFF)
            continue()
        endif()
        if("${_argument}" STREQUAL "-j" OR "${_argument}" STREQUAL "--parallel")
            opendcc_deps_list_append(_result "${_argument}")
            set(_skip_next ON)
        elseif("${_argument}" MATCHES "^--parallel=")
            opendcc_deps_list_append(_result "--parallel")
        else()
            opendcc_deps_list_append(_result "${_argument}")
        endif()
    endforeach()
    set(${out} "${_result}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_json_step out label argv_var)
    opendcc_deps_normalise_argv(_normalised "${argv_var}")
    opendcc_deps_json_array_from_list(_arguments _normalised)
    opendcc_deps_json_quote(_label "${label}")
    set(${out} "{\"label\": ${_label}, \"argv\": ${_arguments}}" PARENT_SCOPE)
endfunction()

# Canonical recipe plan. The key order is fixed because the plan's hash is the identity of a build.
function(opendcc_deps_plan_json out kind_var markers_var patches_var patch_digests_var requires_var steps_var
         env_var)
    opendcc_deps_json_quote(_kind "${${kind_var}}")
    opendcc_deps_json_array_from_list(_markers "${markers_var}")
    opendcc_deps_json_array_from_list(_patches "${patches_var}")
    opendcc_deps_json_array_from_list(_patch_digests "${patch_digests_var}")
    opendcc_deps_json_array_from_list(_requires_json "${requires_var}")

    # Local names must not collide with the variables the caller passed by name: ${steps_var} names the caller's
    # list, and a same-named local here would shadow it.
    set(_steps_json "[]")
    set(_step_texts "")
    foreach(_step IN LISTS ${steps_var})
        opendcc_deps_unpack_step(_label _argv "${_step}")
        opendcc_deps_json_step(_step_json "${_label}" _argv)
        opendcc_deps_list_append(_step_texts "${_step_json}")
    endforeach()
    if(NOT "${_step_texts}" STREQUAL "")
        string(JOIN ", " _steps_json "[${_step_texts}]")
    endif()

    opendcc_deps_json_env(_env_json "${env_var}")

    # A dependency that builds against Python is only equivalent to itself under the same interpreter, and the venv
    # path says nothing about its version: record the version so a Python change rebuilds what links against it.
    set(_python_json "")
    foreach(_required IN LISTS ${requires_var})
        if("${_required}" STREQUAL "python")
            opendcc_deps_json_quote(_python_version "${DEPS_SPEC_PYTHON_VERSION}")
            set(_python_json ", \"python\": ${_python_version}")
        endif()
    endforeach()

    string(CONCAT _plan "{\"kind\": ${_kind}, \"markers\": ${_markers}, \"patches\": ${_patches}, "
                        "\"patch_sha256\": ${_patch_digests}, \"requires\": ${_requires_json}, \"steps\": "
                        "${_steps_json}, \"env\": ${_env_json}${_python_json}}")
    set(${out} "${_plan}" PARENT_SCOPE)
endfunction()

# Environment entries as a JSON object with sorted keys, so two runs describing the same environment hash alike.
function(opendcc_deps_json_env out env_var)
    set(_pairs "")
    foreach(_entry IN LISTS ${env_var})
        string(FIND "${_entry}" "=" _split)
        string(SUBSTRING "${_entry}" 0 ${_split} _key)
        math(EXPR _value_start "${_split}+1")
        string(SUBSTRING "${_entry}" ${_value_start} -1 _value)
        opendcc_deps_list_append(_pairs "${_key}${DEPS_US}${_value}")
    endforeach()
    if(NOT "${_pairs}" STREQUAL "")
        list(SORT _pairs)
    endif()
    set(_text "{")
    set(_first ON)
    foreach(_pair IN LISTS _pairs)
        string(FIND "${_pair}" "${DEPS_US}" _split)
        string(SUBSTRING "${_pair}" 0 ${_split} _key)
        math(EXPR _value_start "${_split}+1")
        string(SUBSTRING "${_pair}" ${_value_start} -1 _value)
        if(_first)
            set(_first OFF)
        else()
            string(APPEND _text ", ")
        endif()
        opendcc_deps_json_quote(_key_json "${_key}")
        opendcc_deps_json_quote(_value_json "${_value}")
        string(APPEND _text "${_key_json}: ${_value_json}")
    endforeach()
    string(APPEND _text "}")
    set(${out} "${_text}" PARENT_SCOPE)
endfunction()

# ----------------------------------------------------------------------------------------------------------
# running a plan

function(opendcc_deps_ensure_layout)
    foreach(_directory downloads src build stamps venv lib bin include share ocio)
        file(MAKE_DIRECTORY "${DEPS_PREFIX}/${_directory}")
    endforeach()
endfunction()

function(opendcc_deps_run_steps name steps_var env_var)
    set(_build "${DEPS_PREFIX}/build/${name}")
    set(_log "${DEPS_PREFIX}/build/${name}.log")
    file(MAKE_DIRECTORY "${_build}")
    file(WRITE "${_log}" "")

    set(_env_args "")
    foreach(_entry IN LISTS ${env_var})
        string(FIND "${_entry}" "=" _split)
        string(SUBSTRING "${_entry}" 0 ${_split} _key)
        math(EXPR _value_start "${_split}+1")
        string(SUBSTRING "${_entry}" ${_value_start} -1 _value)
        if("${_key}" STREQUAL "PATH")
            # The plan names the directories a recipe puts first; the ambient PATH is appended here so it stays out
            # of the stamp.
            set(_value "${_value}${DEPS_PATH_SEPARATOR}$ENV{PATH}")
        endif()
        opendcc_deps_list_append(_env_args "${_key}=${_value}")
    endforeach()

    foreach(_step IN LISTS ${steps_var})
        opendcc_deps_unpack_step(_label _argv "${_step}")
        string(JOIN " " _command_text ${_argv})
        message(STATUS "  ${name}: ${_label}: ${_command_text}")
        string(TIMESTAMP _started "%s")
        execute_process(
            COMMAND "${CMAKE_COMMAND}" -E env ${_env_args} ${_argv}
            WORKING_DIRECTORY "${_build}"
            OUTPUT_VARIABLE _stdout
            ERROR_VARIABLE _stderr
            RESULT_VARIABLE _code)
        file(APPEND "${_log}" "$ ${_command_text}\n${_stdout}${_stderr}")
        string(TIMESTAMP _finished "%s")
        math(EXPR _elapsed "${_finished}-${_started}")
        if(NOT _code EQUAL 0)
            opendcc_deps_tail(_tail "${_log}" 40)
            message(STATUS "--- last 40 lines of the build log ---")
            message(STATUS "${_tail}")
            opendcc_deps_die("${name} failed during ${_label} after ${_elapsed}s; full log: ${_log}")
        endif()
        opendcc_deps_info("${name}: ${_label} ok (${_elapsed}s)")
    endforeach()
endfunction()

# ----------------------------------------------------------------------------------------------------------
# the shared interpreter

function(opendcc_deps_ensure_venv force)
    opendcc_deps_decl(_formula python FORMULA)
    opendcc_deps_brew_prefix(_keg "${_formula}")
    if("${_keg}" STREQUAL "")
        opendcc_deps_die("brew formula \"${_formula}\" is not installed; provision \"python\" first")
    endif()
    set(_version "${DEPS_SPEC_PYTHON_VERSION}")
    set(_exe "${_keg}/bin/python${_version}")
    if(NOT EXISTS "${_exe}")
        opendcc_deps_die("${_exe} is missing; is ${_formula} installed completely?")
    endif()
    # Imported by the application's own python packages (six, numpy) and by usdGenSchema (jinja2).
    set(_packages
        "--upgrade"
        "pip"
        "setuptools"
        "wheel"
        "packaging"
        "pygments==2.5.2"
        "qt.py==2.0.5"
        "six"
        "numpy"
        "jinja2")
    set(_installed "")
    foreach(_package IN LISTS _packages)
        if(NOT "${_package}" MATCHES "^-")
            opendcc_deps_list_append(_installed "${_package}")
        endif()
    endforeach()
    opendcc_deps_sha256_text(_digest "${_version}|${_packages}")
    opendcc_deps_read_stamp(_stamp_version _stamp_sha venv)
    opendcc_deps_platform_venv_python(_venv_python "${DEPS_PREFIX}")

    if("${_stamp_sha}" STREQUAL "${_digest}" AND EXISTS "${_venv_python}" AND NOT force)
        opendcc_deps_info("venv up to date (${_venv_python})")
        return()
    endif()

    set(_venv_dir "${DEPS_PREFIX}/venv")
    if(force OR NOT EXISTS "${_venv_python}")
        opendcc_deps_info("venv: creating ${_venv_dir} with ${_exe}")
        file(REMOVE_RECURSE "${_venv_dir}")
        execute_process(COMMAND "${_exe}" -m venv "${_venv_dir}" RESULT_VARIABLE _code)
        if(NOT _code EQUAL 0)
            opendcc_deps_die("creating the venv with ${_exe} failed (${_code})")
        endif()
    endif()
    opendcc_deps_info("venv: installing ${_installed}")
    execute_process(
        COMMAND "${_venv_python}" -m pip install --no-input ${_packages}
        ECHO_OUTPUT_VARIABLE
        ECHO_ERROR_VARIABLE
        RESULT_VARIABLE _code)
    if(NOT _code EQUAL 0)
        opendcc_deps_die("pip install into ${_venv_dir} failed (${_code})")
    endif()
    opendcc_deps_write_stamp(venv "${_version}" "${_digest}")
endfunction()

# The OCIO config the application loads is runtime data rather than a library, so it is not part of the
# dependency graph, but it is versioned and checksummed like everything else.
function(opendcc_deps_provision_ocio_config)
    if("${DEPS_SPEC_OCIO_URL}" STREQUAL "")
        return()
    endif()
    opendcc_deps_download(
        NAME
        ocio-config
        URL
        "${DEPS_SPEC_OCIO_URL}"
        SHA256
        "${DEPS_SPEC_OCIO_SHA256}"
        OUT_PATH
        _archive
        OUT_SHA
        _sha)
    set(_target "${DEPS_PREFIX}/ocio/config.ocio")
    file(MAKE_DIRECTORY "${DEPS_PREFIX}/ocio")
    configure_file("${_archive}" "${_target}" COPYONLY)
    set(_version "${DEPS_SPEC_OCIO_CONFIG_VERSION}")
    if("${_version}" STREQUAL "")
        set(_version "any")
    endif()
    opendcc_deps_info("ocio config: ${_target} (${_version})")
endfunction()

# ----------------------------------------------------------------------------------------------------------
# the generated cache

# Mirror of the root guard: sha256 over "path|mtime|size;" for every spec file that exists.
function(opendcc_deps_spec_token out)
    set(_token "")
    foreach(_file "${DEPS_SPEC_FILE}" "${DEPS_OVERLAY_FILE}")
        if(NOT "${_file}" STREQUAL "" AND EXISTS "${_file}")
            get_filename_component(_absolute "${_file}" ABSOLUTE)
            file(TIMESTAMP "${_file}" _time "%Y%m%d%H%M%S" UTC)
            file(SIZE "${_file}" _size)
            string(APPEND _token "${_absolute}|${_time}|${_size};")
        endif()
    endforeach()
    string(SHA256 _digest "${_token}")
    set(${out} "${_digest}" PARENT_SCOPE)
endfunction()

# PySide ships its CMake packages inside the site-packages tree, not on any default search path:
# <site-packages>/<package>/lib/cmake/<Package>/<Package>Config.cmake -> the prefix CMake needs is <package>.
function(opendcc_deps_pyside_cmake_prefixes out)
    set(_prefixes "")
    file(GLOB _configs "${DEPS_PREFIX}/venv/lib/python*/site-packages/*/lib/cmake/*/*Config.cmake")
    foreach(_config IN LISTS _configs)
        get_filename_component(_directory "${_config}" DIRECTORY)
        get_filename_component(_directory "${_directory}" DIRECTORY)
        get_filename_component(_directory "${_directory}" DIRECTORY)
        get_filename_component(_package "${_directory}" DIRECTORY)
        opendcc_deps_list_append(_prefixes "${_package}")
    endforeach()
    if(NOT "${_prefixes}" STREQUAL "")
        list(REMOVE_DUPLICATES _prefixes)
        list(SORT _prefixes)
    endif()
    set(${out} "${_prefixes}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_python_site_packages out)
    string(REPLACE "." ";" _parts "${DEPS_SPEC_PYTHON_VERSION}")
    list(GET _parts 0 _major)
    set(_minor "0")
    list(LENGTH _parts _count)
    if(_count GREATER 1)
        list(GET _parts 1 _minor)
    endif()
    opendcc_deps_platform_python_site_packages(_site_packages "${DEPS_PREFIX}" "${_major}" "${_minor}")
    set(${out} "${_site_packages}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_generated_cache_text out)
    opendcc_deps_rel(_spec_rel "${DEPS_SPEC_FILE}")
    get_filename_component(_spec_abs "${DEPS_SPEC_FILE}" ABSOLUTE)
    if(EXISTS "${DEPS_OVERLAY_FILE}")
        opendcc_deps_rel(_overlay_rel "${DEPS_OVERLAY_FILE}")
        get_filename_component(_overlay_abs "${DEPS_OVERLAY_FILE}" ABSOLUTE)
        set(_overlay_shown "${_overlay_rel}")
    else()
        set(_overlay_abs "")
        set(_overlay_shown "(no overlay)")
    endif()
    opendcc_deps_spec_token(_token)

    set(_text "")
    string(APPEND _text "# Generated by cmake --preset ${DEPS_PLATFORM_TAG}-deps from ${_spec_rel}\n")
    string(APPEND _text "# and ${_overlay_shown}. Do not edit: change the spec or the local overlay and re-run\n")
    string(APPEND _text "# the preset instead.\n")
    string(APPEND _text "\n")

    opendcc_deps_quote(_value "${_spec_abs}")
    string(APPEND _text "set(DCC_DEPS_SPEC_FILE ${_value})\n")
    opendcc_deps_quote(_value "${_overlay_abs}")
    string(APPEND _text "set(DCC_DEPS_OVERLAY_FILE ${_value})\n")
    opendcc_deps_quote(_value "${_token}")
    string(APPEND _text "set(DCC_DEPS_SPEC_TOKEN ${_value})\n")
    opendcc_deps_quote(_value "${DEPS_PREFIX}")
    string(APPEND _text "set(DCC_DEPS_PREFIX ${_value})\n")
    string(APPEND _text "\n")

    set(_prefix_path "")
    opendcc_deps_list_append(_prefix_path "${DEPS_PREFIX}")
    opendcc_deps_pyside_cmake_prefixes(_pyside_prefixes)
    foreach(_prefix IN LISTS _pyside_prefixes)
        opendcc_deps_list_append(_prefix_path "${_prefix}")
    endforeach()
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_dep_enabled(_enabled "${_name}")
        if(NOT _enabled)
            continue()
        endif()
        opendcc_deps_decl(_provider "${_name}" PROVIDER)
        if(NOT "${_provider}" STREQUAL "brew")
            continue()
        endif()
        if("${_name}" IN_LIST DEPS_PREFIX_PATH_EXCLUDE)
            continue()
        endif()
        opendcc_deps_decl(_formula "${_name}" FORMULA)
        opendcc_deps_brew_prefix(_keg "${_formula}")
        if(NOT "${_keg}" STREQUAL "")
            opendcc_deps_list_append(_prefix_path "${_keg}")
        endif()
    endforeach()
    # An external dependency's prefix is a complete install tree, not just that dependency: an external USD ships
    # the OpenImageIO, OpenEXR, Imath, OpenColorIO and TBB it was built with. So it goes last, after everything this
    # build provisions, and only answers for packages the spec does not provide. USD's own location does not depend
    # on this order: USD_ROOT, USD_CONFIG_FILE and the rest are forced below.
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_dep_enabled(_enabled "${_name}")
        if(NOT _enabled)
            continue()
        endif()
        opendcc_deps_decl(_provider "${_name}" PROVIDER)
        if(NOT "${_provider}" STREQUAL "external")
            continue()
        endif()
        opendcc_deps_external_prefix(_path "${_name}")
        if(NOT "${_path}" IN_LIST _prefix_path)
            opendcc_deps_list_append(_prefix_path "${_path}")
        endif()
    endforeach()
    set(_line "list(PREPEND CMAKE_PREFIX_PATH")
    foreach(_prefix IN LISTS _prefix_path)
        opendcc_deps_quote(_quoted "${_prefix}")
        string(APPEND _line " ${_quoted}")
    endforeach()
    string(APPEND _line ")")
    string(APPEND _text "${_line}\n")
    string(APPEND _text "\n")

    # The include roots of everything this build provisions, for the application to put on the compiler line before
    # any library's interface include directories (Packages.cmake does that). A dependency's prefix is normally only
    # its own headers, but an external dependency's is a whole toolchain, and it is reached through USD's imported
    # targets, which come after the target's own includes: without this list `<OpenImageIO/imagebuf.h>` resolves to
    # the external USD's copy while the build links the OpenImageIO the spec provisions.
    set(_include_dirs "")
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_dep_enabled(_enabled "${_name}")
        if(NOT _enabled)
            continue()
        endif()
        if("${_name}" IN_LIST DEPS_PREFIX_PATH_EXCLUDE)
            continue()
        endif()
        opendcc_deps_decl(_provider "${_name}" PROVIDER)
        if("${_provider}" STREQUAL "external" OR "${_provider}" STREQUAL "manual")
            continue()
        endif()
        opendcc_deps_keg(_keg "${_name}")
        if(IS_DIRECTORY "${_keg}/include" AND NOT "${_keg}/include" IN_LIST _include_dirs)
            opendcc_deps_list_append(_include_dirs "${_keg}/include")
        endif()
    endforeach()
    # Then the external installations, in the same list and in that order: they carry what the external build itself
    # uses (a TBB its pxr headers instantiate, Imath, MaterialX), which this build may compile against but must not
    # put ahead of its own dependencies, and which has to beat the ambient Homebrew include directory that some
    # imported target adds.
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_dep_enabled(_enabled "${_name}")
        if(NOT _enabled)
            continue()
        endif()
        opendcc_deps_decl(_provider "${_name}" PROVIDER)
        if(NOT "${_provider}" STREQUAL "external")
            continue()
        endif()
        opendcc_deps_external_prefix(_path "${_name}")
        if(IS_DIRECTORY "${_path}/include" AND NOT "${_path}/include" IN_LIST _include_dirs)
            opendcc_deps_list_append(_include_dirs "${_path}/include")
        endif()
    endforeach()
    if(NOT "${_include_dirs}" STREQUAL "")
        set(_line "set(DCC_DEPS_INCLUDE_DIRS")
        foreach(_directory IN LISTS _include_dirs)
            opendcc_deps_quote(_quoted "${_directory}")
            string(APPEND _line " ${_quoted}")
        endforeach()
        string(APPEND _line ")")
        string(APPEND _text "${_line}\n")
        string(APPEND _text "\n")
    endif()

    string(APPEND _text
           "# Which dependencies are enabled, and at which version. Authoritative, not cache variables.\n")
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_key(_key "${_name}")
        opendcc_deps_dep_enabled(_enabled "${_name}")
        opendcc_deps_decl(_version "${_name}" VERSION)
        if(_enabled)
            set(_enabled_text "ON")
        else()
            set(_enabled_text "OFF")
        endif()
        opendcc_deps_quote(_version_text "${_version}")
        string(APPEND _text "set(DCC_DEPS_${_key}_ENABLED ${_enabled_text})\n")
        string(APPEND _text "set(DCC_DEPS_${_key}_VERSION ${_version_text})\n")
    endforeach()
    string(APPEND _text "\n")

    string(APPEND _text "# USD build switches, one per spec feature.\n")
    foreach(_feature IN LISTS DEPS_USD_FEATURES)
        opendcc_deps_dep_feature(_on usd "${_feature}")
        if(_on)
            set(_feature_text "ON")
        else()
            set(_feature_text "OFF")
        endif()
        string(TOUPPER "${_feature}" _feature_key)
        string(APPEND _text "set(DCC_DEPS_USD_FEATURE_${_feature_key} ${_feature_text})\n")
    endforeach()
    string(APPEND _text "\n")

    opendcc_deps_python_site_packages(_site_packages)
    opendcc_deps_quote(_value "${_site_packages}")
    string(APPEND _text "set(DCC_DEPS_PYTHON_SITE_PACKAGES ${_value})\n")
    string(APPEND _text "\n")

    set(_ocio_config "${DEPS_PREFIX}/ocio/config.ocio")
    if(EXISTS "${_ocio_config}")
        opendcc_deps_quote(_value "${_ocio_config}")
        string(APPEND _text "set(DCC_DEPS_OCIO_CONFIG_FILE ${_value})\n")
        string(APPEND _text "\n")
    endif()

    string(APPEND _text "# Finder roots, for enabled dependencies only.\n")
    set(_emitted "")
    opendcc_deps_dep_enabled(_qtbase_enabled qtbase)
    if(_qtbase_enabled)
        opendcc_deps_qt_install_prefix(_qt_prefix)
        opendcc_deps_qt_major(_qt_major)
        if(EXISTS "${_qt_prefix}/lib/cmake/Qt${_qt_major}/Qt${_qt_major}Config.cmake")
            opendcc_deps_quote(_value "${_qt_prefix}/lib/cmake/Qt${_qt_major}")
            string(APPEND _text "set(Qt${_qt_major}_DIR ${_value} CACHE PATH \"\")\n")
            opendcc_deps_list_append(_emitted "Qt${_qt_major}_DIR")
        endif()
    endif()
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_dep_enabled(_enabled "${_name}")
        if(NOT _enabled)
            continue()
        endif()
        opendcc_deps_decl(_variables "${_name}" CMAKE_VARS)
        if("${_variables}" STREQUAL "")
            continue()
        endif()
        # First variable wins: a dependency may not re-point a root another one already defines.
        set(_entries "${_variables}")
        list(SORT _entries)
        foreach(_entry IN LISTS _entries)
            string(FIND "${_entry}" "=" _split)
            string(SUBSTRING "${_entry}" 0 ${_split} _variable)
            if("${_variable}" IN_LIST _emitted)
                continue()
            endif()
            math(EXPR _value_start "${_split}+1")
            string(SUBSTRING "${_entry}" ${_value_start} -1 _raw_value)
            if("${_raw_value}" MATCHES "@MANUAL@")
                continue()
            endif()
            opendcc_deps_decl(_formula "${_name}" FORMULA)
            opendcc_deps_decl(_provider "${_name}" PROVIDER)
            opendcc_deps_dependency_prefix(_dependency_prefix "${_name}")
            set(_expanded "${_raw_value}")
            string(REPLACE "@PREFIX@" "${_dependency_prefix}" _expanded "${_expanded}")
            if("${_expanded}" MATCHES "@FORMULA@")
                if("${_provider}" STREQUAL "external")
                    # An external installation has no formula to name: its own prefix answers both tokens.
                    set(_keg "${_dependency_prefix}")
                else()
                    opendcc_deps_brew_prefix(_keg "${_formula}")
                endif()
                string(REPLACE "@FORMULA@" "${_keg}" _expanded "${_expanded}")
            endif()
            if("${_variable}" MATCHES "^(PYTHON_EXECUTABLE|Python3_EXECUTABLE|Python_EXECUTABLE)$")
                set(_cache_type "FILEPATH")
            else()
                set(_cache_type "PATH")
            endif()
            opendcc_deps_quote(_value "${_expanded}")
            string(APPEND _text "set(${_variable} ${_value} CACHE ${_cache_type} \"\")\n")
            opendcc_deps_list_append(_emitted "${_variable}")
        endforeach()
    endforeach()
    string(APPEND _text "\n")

    # USD's location is authoritative in the generated cache: FindPxrUSD resolves USD_ROOT, the include/library
    # directories, pxrConfig.cmake and usdGenSchema once and then reuses the cached answers, so switching prefixes
    # in an existing build directory would silently keep the old one. Forced, and placed after the finder roots
    # above so they win over the generic USD_ROOT the spec exports.
    opendcc_deps_dep_enabled(_usd_enabled usd)
    if(_usd_enabled)
        opendcc_deps_decl(_usd_provider usd PROVIDER)
        opendcc_deps_dependency_prefix(_usd_prefix usd)
        opendcc_deps_usd_paths(_usd_include _usd_library _usd_config _usd_genschema _usd_problems "${_usd_prefix}")
        string(APPEND _text
               "# USD's location, from the spec. Authoritative: a previous configure cannot keep its own.\n")
        opendcc_deps_quote(_value "${_usd_prefix}")
        string(APPEND _text "set(USD_ROOT ${_value} CACHE PATH \"\" FORCE)\n")
        opendcc_deps_quote(_value "${_usd_include}")
        string(APPEND _text "set(USD_INCLUDE_DIR ${_value} CACHE PATH \"\" FORCE)\n")
        opendcc_deps_quote(_value "${_usd_library}")
        string(APPEND _text "set(USD_LIBRARY_DIR ${_value} CACHE PATH \"\" FORCE)\n")
        opendcc_deps_quote(_value "${_usd_config}")
        string(APPEND _text "set(USD_CONFIG_FILE ${_value} CACHE FILEPATH \"\" FORCE)\n")
        opendcc_deps_quote(_value "${_usd_genschema}")
        string(APPEND _text "set(USD_GENSCHEMA_SCRIPT ${_value} CACHE FILEPATH \"\" FORCE)\n")
        if("${_usd_provider}" STREQUAL "external")
            # The install rpath has to prefer this lib directory over a copy left in the dependency prefix.
            opendcc_deps_quote(_value "${_usd_prefix}")
            string(APPEND _text "set(DCC_DEPS_USD_EXTERNAL_PREFIX ${_value} CACHE PATH \"\" FORCE)\n")
            opendcc_deps_quote(_value "${_usd_library}")
            string(APPEND _text "set(DCC_DEPS_USD_EXTERNAL_LIB_DIR ${_value} CACHE PATH \"\" FORCE)\n")
        else()
            # Empty on purpose: switching back from an external USD must drop its rpath entry and its prefix.
            string(APPEND _text "set(DCC_DEPS_USD_EXTERNAL_PREFIX \"\" CACHE PATH \"\" FORCE)\n")
            string(APPEND _text "set(DCC_DEPS_USD_EXTERNAL_LIB_DIR \"\" CACHE PATH \"\" FORCE)\n")
        endif()
        string(APPEND _text "\n")
    endif()

    string(APPEND _text "# Fixed by the provisioned-prefix model; a preset or -D value still wins.\n")
    foreach(_variable IN LISTS DEPS_CMAKE_BOOL_DEFAULTS)
        string(APPEND _text "set(${_variable} ON CACHE BOOL \"\")\n")
    endforeach()
    string(APPEND _text "\n")

    # These are cache entries with FORCE on purpose: a plain default would be shadowed by the value the previous
    # configure left in CMakeCache.txt, so editing the spec would silently have no effect.
    string(APPEND _text "# opendcc.* from the spec. Authoritative: change the spec, not a -D or preset value.\n")
    set(_opendcc_variables "")
    foreach(_entry IN LISTS DEPS_OPENDCC_KEYS)
        string(FIND "${_entry}" "=" _split)
        string(SUBSTRING "${_entry}" 0 ${_split} _key)
        math(EXPR _value_start "${_split}+1")
        string(SUBSTRING "${_entry}" ${_value_start} -1 _variable)
        opendcc_deps_list_append(_opendcc_variables "${_key}:${_variable}")
    endforeach()
    opendcc_deps_list_append(_opendcc_variables "arnold_support:DCC_USD_FALLBACK_PROXY_BUILD_ARNOLD_USD")
    opendcc_deps_list_append(_opendcc_variables "cycles_support:DCC_USD_FALLBACK_PROXY_BUILD_CYCLES")
    foreach(_entry IN LISTS _opendcc_variables)
        string(FIND "${_entry}" ":" _split)
        string(SUBSTRING "${_entry}" 0 ${_split} _key)
        math(EXPR _value_start "${_split}+1")
        string(SUBSTRING "${_entry}" ${_value_start} -1 _variable)
        opendcc_deps_opendcc(_on "${_key}")
        if(_on)
            set(_value_text "ON")
        else()
            set(_value_text "OFF")
        endif()
        string(APPEND _text "set(${_variable} ${_value_text} CACHE BOOL \"\" FORCE)\n")
    endforeach()
    string(APPEND _text "\n")

    set(${out} "${_text}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_write_generated_cache out path)
    opendcc_deps_generated_cache_text(_text)
    file(MAKE_DIRECTORY "${DEPS_PREFIX}")
    file(WRITE "${path}.tmp" "${_text}")
    file(RENAME "${path}.tmp" "${path}")
    set(${out} "${path}" PARENT_SCOPE)
endfunction()

# ----------------------------------------------------------------------------------------------------------
# reporting

function(opendcc_deps_dep_state out name)
    opendcc_deps_dep_enabled(_enabled "${name}")
    if(NOT _enabled)
        set(${out} "disabled" PARENT_SCOPE)
        return()
    endif()
    opendcc_deps_decl(_provider "${name}" PROVIDER)
    if("${_provider}" STREQUAL "external")
        opendcc_deps_external_state(_external_state _problems "${name}")
        set(${out} "${_external_state}" PARENT_SCOPE)
        return()
    endif()
    if("${_provider}" STREQUAL "brew")
        opendcc_deps_decl(_formula "${name}" FORMULA)
        opendcc_deps_brew_version(_installed "${_formula}")
        if("${_installed}" STREQUAL "")
            set(${out} "missing" PARENT_SCOPE)
            return()
        endif()
        opendcc_deps_decl(_pin "${name}" VERSION)
        opendcc_deps_version_matches(_matches "${_pin}" "${_installed}")
        if(_matches)
            set(${out} "ok" PARENT_SCOPE)
        else()
            set(${out} "drift" PARENT_SCOPE)
        endif()
        return()
    endif()
    if("${_provider}" STREQUAL "source" OR "${_provider}" STREQUAL "headers")
        opendcc_deps_key(_key "${name}")
        if(NOT DEFINED DEPS_RECIPE_${_key}_KIND)
            set(${out} "no recipe" PARENT_SCOPE)
            return()
        endif()
        opendcc_deps_recipe_present(_present "${name}")
        if(NOT _present)
            set(${out} "missing" PARENT_SCOPE)
            return()
        endif()
        opendcc_deps_read_stamp(_stamp_version _stamp_sha "${name}")
        opendcc_deps_recipe_digest(_digest "${name}")
        if("${_stamp_sha}" STREQUAL "${_digest}")
            set(${out} "ok" PARENT_SCOPE)
        else()
            set(${out} "stale" PARENT_SCOPE)
        endif()
        return()
    endif()
    set(${out} "manual" PARENT_SCOPE)
endfunction()

function(opendcc_deps_pack_row out)
    set(_packed "")
    math(EXPR _last "${ARGC}-1")
    foreach(_index RANGE 1 ${_last})
        if("${_packed}" STREQUAL "")
            set(_packed "${ARGV${_index}}")
        else()
            string(APPEND _packed "${DEPS_US}${ARGV${_index}}")
        endif()
    endforeach()
    set(${out} "${_packed}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_unpack_row out packed)
    string(REPLACE "${DEPS_US}" ";" _cells "${packed}")
    set(${out} "${_cells}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_print_table header_packed rows_var)
    opendcc_deps_unpack_row(_header "${header_packed}")
    list(LENGTH _header _columns)

    set(_widths "")
    foreach(_column IN LISTS _header)
        string(LENGTH "${_column}" _length)
        opendcc_deps_list_append(_widths "${_length}")
    endforeach()
    math(EXPR _last_column "${_columns}-1")
    foreach(_row IN LISTS ${rows_var})
        opendcc_deps_unpack_row(_cells "${_row}")
        foreach(_index RANGE 0 ${_last_column})
            list(GET _cells ${_index} _cell)
            list(GET _widths ${_index} _width)
            string(LENGTH "${_cell}" _length)
            if(_length GREATER _width)
                list(REMOVE_AT _widths ${_index})
                list(INSERT _widths ${_index} "${_length}")
            endif()
        endforeach()
    endforeach()

    set(_line "")
    set(_separator "")
    foreach(_index RANGE 0 ${_last_column})
        list(GET _header ${_index} _column)
        list(GET _widths ${_index} _width)
        string(LENGTH "${_column}" _length)
        math(EXPR _padding "${_width}-${_length}")
        string(REPEAT " " ${_padding} _spaces)
        opendcc_deps_list_append(_line "${_column}${_spaces}")
        string(REPEAT "-" ${_width} _dashes)
        opendcc_deps_list_append(_separator "${_dashes}")
    endforeach()
    string(JOIN "  " _header_text ${_line})
    string(JOIN "  " _separator_text ${_separator})
    string(REGEX REPLACE " +$" "" _header_text "${_header_text}")
    string(REGEX REPLACE " +$" "" _separator_text "${_separator_text}")
    message(STATUS "${_header_text}")
    message(STATUS "${_separator_text}")

    foreach(_row IN LISTS ${rows_var})
        opendcc_deps_unpack_row(_cells "${_row}")
        set(_line "")
        foreach(_index RANGE 0 ${_last_column})
            list(GET _cells ${_index} _cell)
            list(GET _widths ${_index} _width)
            string(LENGTH "${_cell}" _length)
            math(EXPR _padding "${_width}-${_length}")
            string(REPEAT " " ${_padding} _spaces)
            opendcc_deps_list_append(_line "${_cell}${_spaces}")
        endforeach()
        string(JOIN "  " _row_text ${_line})
        string(REGEX REPLACE " +$" "" _row_text "${_row_text}")
        message(STATUS "${_row_text}")
    endforeach()
endfunction()

function(opendcc_deps_report_check out)
    set(_rows "")
    set(_problems "")
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_dep_state(_state "${_name}")
        opendcc_deps_decl(_raw_version "${_name}" VERSION)
        opendcc_deps_decl(_provider "${_name}" PROVIDER)
        set(_version "${_raw_version}")
        if("${_version}" STREQUAL "")
            set(_version "-")
        endif()
        if("${_provider}" STREQUAL "")
            set(_provider "-")
        endif()
        opendcc_deps_pack_row(_row "${_name}" "${_version}" "${_provider}" "${_state}")
        opendcc_deps_list_append(_rows "${_row}")

        if("${_provider}" STREQUAL "external")
            # An external dependency's state is only "ok" when every disagreement was absent, so list them all.
            opendcc_deps_external_problems(_foreign _notes "${_name}")
            foreach(_problem IN LISTS _foreign)
                opendcc_deps_list_append(_problems "${_problem}")
            endforeach()
        elseif("${_state}" STREQUAL "drift")
            opendcc_deps_decl(_formula "${_name}" FORMULA)
            opendcc_deps_brew_version(_installed "${_formula}")
            opendcc_deps_drift_message(_message "${_name}" "${_installed}" "${_raw_version}"
                                       "${DEPS_OVERLAY_FILE}")
            opendcc_deps_list_append(_problems "${_message}")
        elseif("${_state}" STREQUAL "no recipe")
            opendcc_deps_decl(_raw_provider "${_name}" PROVIDER)
            string(CONCAT _problem "enabled ${_raw_provider} dependency \"${_name}\" has no recipe "
                                   "in cmake/deps/DepsRecipes.cmake")
            opendcc_deps_list_append(_problems "${_problem}")
        elseif("${_state}" STREQUAL "stale")
            string(CONCAT _problem "${_name} in the prefix was built from a different spec; re-run "
                                   "cmake --preset ${DEPS_PLATFORM_TAG}-deps")
        opendcc_deps_list_append(_problems "${_problem}")
        elseif("${_state}" STREQUAL "missing")
            opendcc_deps_list_append(_problems "${_name} ${_raw_version} is not provisioned")
        endif()
    endforeach()
    opendcc_deps_pack_row(_header name version provider state)
    opendcc_deps_print_table("${_header}" _rows)
    set(${out} "${_problems}" PARENT_SCOPE)
endfunction()

function(opendcc_deps_report_list)
    set(_rows "")
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_decl(_version "${_name}" VERSION)
        opendcc_deps_decl(_provider "${_name}" PROVIDER)
        opendcc_deps_decl(_formula "${_name}" FORMULA)
        opendcc_deps_decl(_url "${_name}" URL)
        opendcc_deps_dep_enabled(_enabled "${_name}")
        if("${_provider}" STREQUAL "brew")
            set(_source "${_formula}")
        elseif("${_provider}" STREQUAL "external")
            opendcc_deps_external_prefix(_source "${_name}")
        else()
            set(_source "${_url}")
        endif()
        if("${_source}" STREQUAL "")
            set(_source "-")
        endif()
        if("${_version}" STREQUAL "")
            set(_version "-")
        endif()
        if("${_provider}" STREQUAL "")
            set(_provider "-")
        endif()
        if(_enabled)
            set(_enabled_text "yes")
        else()
            set(_enabled_text "no")
        endif()
        opendcc_deps_pack_row(_row "${_name}" "${_version}" "${_enabled_text}" "${_provider}" "${_source}")
        opendcc_deps_list_append(_rows "${_row}")
    endforeach()
    opendcc_deps_pack_row(_header name version enabled provider "source of truth")
    opendcc_deps_print_table("${_header}" _rows)
endfunction()

# One dependency as JSON, keys in alphabetical order; only the fields the spec states are emitted.
function(opendcc_deps_dependency_json out name)
    set(_body "")
    set(_first ON)

    opendcc_deps_decl(_variables "${name}" CMAKE_VARS)
    if(NOT "${_variables}" STREQUAL "")
        set(_members "")
        foreach(_entry IN LISTS _variables)
            string(FIND "${_entry}" "=" _split)
            string(SUBSTRING "${_entry}" 0 ${_split} _variable)
            math(EXPR _value_start "${_split}+1")
            string(SUBSTRING "${_entry}" ${_value_start} -1 _value)
            opendcc_deps_json_quote(_key_json "${_variable}")
            opendcc_deps_json_quote(_value_json "${_value}")
            opendcc_deps_list_append(_members "${_key_json}: ${_value_json}")
        endforeach()
        string(JOIN ", " _members_text ${_members})
        opendcc_deps_json_field(_body _first "cmake_vars" "{${_members_text}}")
    endif()

    opendcc_deps_dep_enabled(_enabled "${name}")
    opendcc_deps_json_bool(_enabled_json "${_enabled}")
    opendcc_deps_json_field(_body _first "enabled" "${_enabled_json}")

    opendcc_deps_decl(_expect "${name}" EXPECT)
    if(NOT "${_expect}" STREQUAL "")
        opendcc_deps_json_quote(_expect_json "${_expect}")
        opendcc_deps_json_field(_body _first "expect" "${_expect_json}")
    endif()

    opendcc_deps_decl(_features "${name}" FEATURES)
    if(NOT "${_features}" STREQUAL "")
        set(_members "")
        foreach(_entry IN LISTS _features)
            string(FIND "${_entry}" "=" _split)
            string(SUBSTRING "${_entry}" 0 ${_split} _feature)
            math(EXPR _value_start "${_split}+1")
            string(SUBSTRING "${_entry}" ${_value_start} -1 _value)
            opendcc_deps_json_quote(_key_json "${_feature}")
            if("${_value}" STREQUAL "ON")
                set(_value_json "true")
            else()
                set(_value_json "false")
            endif()
            opendcc_deps_list_append(_members "${_key_json}: ${_value_json}")
        endforeach()
        string(JOIN ", " _members_text ${_members})
        opendcc_deps_json_field(_body _first "features" "{${_members_text}}")
    endif()

    opendcc_deps_decl(_formula "${name}" FORMULA)
    if(NOT "${_formula}" STREQUAL "")
        opendcc_deps_json_quote(_formula_json "${_formula}")
        opendcc_deps_json_field(_body _first "formula" "${_formula_json}")
    endif()

    opendcc_deps_decl(_provider "${name}" PROVIDER)
    if(NOT "${_provider}" STREQUAL "")
        opendcc_deps_json_quote(_provider_json "${_provider}")
        opendcc_deps_json_field(_body _first "provider" "${_provider_json}")
    endif()

    set(_lockable OFF)
    if("${_provider}" STREQUAL "source" OR "${_provider}" STREQUAL "headers")
        set(_lockable ON)
    endif()
    opendcc_deps_decl(_sha "${name}" SHA256)
    if(NOT "${_sha}" STREQUAL "")
        opendcc_deps_json_quote(_sha_json "${_sha}")
        opendcc_deps_json_field(_body _first "sha256" "${_sha_json}")
    elseif(_lockable)
        # An unpinned source archive: state it, so the merged spec says what the lock will cover.
        opendcc_deps_json_field(_body _first "sha256" "null")
    endif()

    if(_lockable)
        opendcc_deps_decl(_strip "${name}" STRIP)
        opendcc_deps_json_field(_body _first "strip" "${_strip}")
    endif()

    opendcc_deps_decl(_url "${name}" URL)
    if(NOT "${_url}" STREQUAL "")
        opendcc_deps_json_quote(_url_json "${_url}")
        opendcc_deps_json_field(_body _first "url" "${_url_json}")
    endif()

    opendcc_deps_decl(_version "${name}" VERSION)
    if(NOT "${_version}" STREQUAL "")
        opendcc_deps_json_quote(_version_json "${_version}")
        opendcc_deps_json_field(_body _first "version" "${_version_json}")
    endif()

    set(${out} "{ ${_body} }" PARENT_SCOPE)
endfunction()

# The merged spec as JSON, for `--print-config`: fixed top-level order, dependencies sorted, 2-space indent.
function(opendcc_deps_config_json out)
    set(_text "{\n")

    string(APPEND _text "  \"schema\": ${DEPS_SPEC_SCHEMA},\n")
    opendcc_deps_json_quote(_platform "${DEPS_SPEC_PLATFORM}")
    string(APPEND _text "  \"platform\": ${_platform},\n")

    opendcc_deps_json_quote(_version "${DEPS_SPEC_PYTHON_VERSION}")
    opendcc_deps_json_quote(_provider "${DEPS_SPEC_PYTHON_PROVIDER}")
    opendcc_deps_json_quote(_formula "${DEPS_SPEC_PYTHON_FORMULA}")
    string(APPEND _text "  \"python\": {\n")
    string(APPEND _text "    \"version\": ${_version},\n")
    string(APPEND _text "    \"provider\": ${_provider},\n")
    string(APPEND _text "    \"formula\": ${_formula}\n")
    string(APPEND _text "  },\n")

    opendcc_deps_json_quote(_qt_version "${DEPS_SPEC_QT_VERSION}")
    opendcc_deps_json_quote(_qt_pyside "${DEPS_SPEC_QT_PYSIDE}")
    string(APPEND _text "  \"qt\": {\n")
    string(APPEND _text "    \"version\": ${_qt_version},\n")
    string(APPEND _text "    \"pyside\": ${_qt_pyside}\n")
    string(APPEND _text "  },\n")

    opendcc_deps_json_quote(_ocio_version "${DEPS_SPEC_OCIO_CONFIG_VERSION}")
    opendcc_deps_json_quote(_ocio_url "${DEPS_SPEC_OCIO_URL}")
    opendcc_deps_json_quote(_ocio_sha "${DEPS_SPEC_OCIO_SHA256}")
    string(APPEND _text "  \"ocio\": {\n")
    string(APPEND _text "    \"config_version\": ${_ocio_version},\n")
    string(APPEND _text "    \"url\": ${_ocio_url},\n")
    string(APPEND _text "    \"sha256\": ${_ocio_sha}\n")
    string(APPEND _text "  },\n")

    string(APPEND _text "  \"opendcc\": {\n")
    set(_lines "")
    foreach(_entry IN LISTS DEPS_OPENDCC_KEYS)
        string(FIND "${_entry}" "=" _split)
        string(SUBSTRING "${_entry}" 0 ${_split} _key)
        opendcc_deps_opendcc(_on "${_key}")
        opendcc_deps_json_quote(_key_json "${_key}")
        opendcc_deps_json_bool(_on_json "${_on}")
        opendcc_deps_list_append(_lines "\"${_key}\": ${_on_json}")
    endforeach()
    string(JOIN ",\n    " _opendcc_text ${_lines})
    string(APPEND _text "    ${_opendcc_text}\n")
    string(APPEND _text "  },\n")

    set(_entries "")
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_key(_key "${_name}")
        if(NOT DEPS_DECL_${_key}_DECLARED)
            continue()
        endif()
        opendcc_deps_dependency_json(_dependency "${_name}")
        opendcc_deps_json_quote(_name_json "${_name}")
        opendcc_deps_list_append(_entries "    ${_name_json}: ${_dependency}")
    endforeach()
    if("${_entries}" STREQUAL "")
        string(APPEND _text "  \"dependencies\": {}\n")
    else()
        list(SORT _entries)
        string(JOIN ",\n" _dependencies_text ${_entries})
        string(APPEND _text "  \"dependencies\": {\n${_dependencies_text}\n  }\n")
    endif()
    string(APPEND _text "}\n")
    set(${out} "${_text}" PARENT_SCOPE)
endfunction()

# ----------------------------------------------------------------------------------------------------------
# entry point

function(opendcc_deps_main)
    opendcc_deps_rel(_spec_rel "${DEPS_SPEC_FILE}")
    opendcc_deps_rel(_overlay_rel "${DEPS_OVERLAY_FILE}")
    if(NOT EXISTS "${DEPS_OVERLAY_FILE}")
        set(_overlay_rel "none (${_overlay_rel} absent, ignored)")
    endif()
    set(_header "spec     ${_spec_rel}\noverlay  ${_overlay_rel}\nprefix   ${DEPS_PREFIX}")

    # print-config keeps stdout machine readable, so the context goes to stderr there; message() without a mode
    # writes to stderr in both configure and script mode.
    if("${DEPS_MODE}" STREQUAL "print-config")
        message("${_header}")
        opendcc_deps_report_alignment()
        opendcc_deps_config_json(_json)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_json}")
        return()
    endif()
    message(STATUS "${_header}")
    message(STATUS "")
    opendcc_deps_report_alignment()

    if("${DEPS_MODE}" STREQUAL "list")
        opendcc_deps_report_list()
        return()
    endif()

    if("${DEPS_MODE}" STREQUAL "check")
        opendcc_deps_report_check(_problems)
        if(NOT "${_problems}" STREQUAL "")
            list(LENGTH _problems _problem_count)
            message(STATUS "")
            foreach(_problem IN LISTS _problems)
                message(STATUS "  ${_problem}")
            endforeach()
            opendcc_deps_die("dependency check failed: ${_problem_count} problem(s)")
        endif()
        message(STATUS "")
        message(STATUS "all enabled dependencies are provisioned")
        return()
    endif()

    opendcc_deps_platform_check_toolchain()
    opendcc_deps_ensure_layout()

    set(_only "")
    if(DEFINED ENV{OPENDCC_DEPS_ONLY})
        string(REPLACE "," ";" _only_parts "$ENV{OPENDCC_DEPS_ONLY}")
        foreach(_part IN LISTS _only_parts)
            string(STRIP "${_part}" _part)
            if(NOT "${_part}" STREQUAL "")
                opendcc_deps_list_append(_only "${_part}")
            endif()
        endforeach()
    endif()
    set(_forced "")
    if(DEFINED ENV{OPENDCC_DEPS_FORCE})
        string(REPLACE "," ";" _forced_parts "$ENV{OPENDCC_DEPS_FORCE}")
        foreach(_part IN LISTS _forced_parts)
            string(STRIP "${_part}" _part)
            if(NOT "${_part}" STREQUAL "")
                opendcc_deps_list_append(_forced "${_part}")
            endif()
        endforeach()
    endif()
    foreach(_entry IN LISTS _only)
        if(NOT "${_entry}" IN_LIST DEPS_KNOWN_DEPENDENCIES)
            opendcc_deps_die("unknown dependency \"${_entry}\" in OPENDCC_DEPS_ONLY")
        endif()
    endforeach()
    foreach(_entry IN LISTS _forced)
        if(NOT "${_entry}" IN_LIST DEPS_KNOWN_DEPENDENCIES AND NOT "${_entry}" STREQUAL "venv")
            opendcc_deps_die("unknown dependency \"${_entry}\" in OPENDCC_DEPS_FORCE")
        endif()
    endforeach()

    set(_enabled "")
    foreach(_name IN LISTS DEPS_KNOWN_DEPENDENCIES)
        opendcc_deps_dep_enabled(_on "${_name}")
        if(_on)
            opendcc_deps_list_append(_enabled "${_name}")
        endif()
    endforeach()
    if("${_only}" STREQUAL "")
        set(_targets "${_enabled}")
    else()
        set(_targets "${_only}")
    endif()

    set(_update_lock OFF)
    if(DEFINED ENV{OPENDCC_DEPS_UPDATE_LOCK})
        opendcc_deps_is_true(_update_lock "$ENV{OPENDCC_DEPS_UPDATE_LOCK}")
    endif()
    if(_update_lock)
        message(STATUS "")
        message(STATUS "lock:")
        foreach(_name IN LISTS _targets)
            opendcc_deps_decl(_provider "${_name}" PROVIDER)
            if("${_provider}" STREQUAL "source" OR "${_provider}" STREQUAL "headers")
                opendcc_deps_decl(_url "${_name}" URL)
                opendcc_deps_decl(_sha "${_name}" SHA256)
                opendcc_deps_download(
                    REHASH
                    NAME
                    "${_name}"
                    URL
                    "${_url}"
                    SHA256
                    "${_sha}"
                    OUT_PATH
                    _archive
                    OUT_SHA
                    _digest)
            endif()
        endforeach()
        get_property(_lock_dirty GLOBAL PROPERTY DEPS_LOCK_DIRTY)
        if(_lock_dirty)
            opendcc_deps_lock_save("${DEPS_LOCK_FILE}")
            opendcc_deps_rel(_lock_rel "${DEPS_LOCK_FILE}")
            opendcc_deps_info("updated ${_lock_rel}")
            set_property(GLOBAL PROPERTY DEPS_LOCK_DIRTY OFF)
        endif()
        message(STATUS "")
    endif()

    # Bottles and the shared interpreter first: every source build links against them.
    set(_brew_targets "")
    set(_source_targets "")
    set(_external_targets "")
    foreach(_name IN LISTS _targets)
        opendcc_deps_decl(_provider "${_name}" PROVIDER)
        if("${_provider}" STREQUAL "brew")
            opendcc_deps_list_append(_brew_targets "${_name}")
        elseif("${_provider}" STREQUAL "source" OR "${_provider}" STREQUAL "headers")
            opendcc_deps_list_append(_source_targets "${_name}")
        elseif("${_provider}" STREQUAL "external")
            opendcc_deps_list_append(_external_targets "${_name}")
        endif()
    endforeach()
    opendcc_deps_provision(_brew_targets _forced)

    if(NOT "${DEPS_SPEC_OCIO_URL}" STREQUAL "")
        message(STATUS "ocio config:")
        opendcc_deps_provision_ocio_config()
        message(STATUS "")
    endif()

    set(_needs_venv OFF)
    if("${_only}" STREQUAL "")
        set(_needs_venv ON)
    else()
        foreach(_entry python pyside usd)
            if("${_entry}" IN_LIST _targets)
                set(_needs_venv ON)
            endif()
        endforeach()
    endif()
    if(_needs_venv)
        set(_force_venv OFF)
        if("venv" IN_LIST _forced)
            set(_force_venv ON)
        endif()
        opendcc_deps_ensure_venv(${_force_venv})
        message(STATUS "")
    endif()

    # External dependencies are verified, not built: the comparison runs against the kegs provisioned above and
    # imports with the venv interpreter, so it has to come after both.
    if(NOT "${_external_targets}" STREQUAL "")
        opendcc_deps_provision(_external_targets _forced)
        message(STATUS "")
    endif()

    opendcc_deps_order_targets(_ordered_sources _source_targets)
    opendcc_deps_provision(_ordered_sources _forced)

    get_property(_lock_dirty GLOBAL PROPERTY DEPS_LOCK_DIRTY)
    if(_lock_dirty)
        opendcc_deps_lock_save("${DEPS_LOCK_FILE}")
        opendcc_deps_rel(_lock_rel "${DEPS_LOCK_FILE}")
        opendcc_deps_info("recorded new pins in ${_lock_rel}")
    endif()

    opendcc_deps_write_generated_cache(_cache "${DEPS_PREFIX}/deps.generated.cmake")
    opendcc_deps_rel(_cache_rel "${_cache}")
    opendcc_deps_info("wrote ${_cache_rel}")

    set(_incomplete "")
    foreach(_name IN LISTS _enabled)
        opendcc_deps_dep_state(_state "${_name}")
        if("${_state}" STREQUAL "missing"
           OR "${_state}" STREQUAL "mismatch"
           OR "${_state}" STREQUAL "drift"
           OR "${_state}" STREQUAL "stale"
           OR "${_state}" STREQUAL "no recipe")
            opendcc_deps_list_append(_incomplete "${_name}")
        endif()
    endforeach()

    if(NOT "${_incomplete}" STREQUAL "")
        message(STATUS "")
        if(NOT "${_only}" STREQUAL "")
            string(REPLACE ";" ", " _incomplete_text "${_incomplete}")
            message(STATUS "  note: ${_incomplete_text} still not provisioned; a full run completes them")
        else()
            foreach(_name IN LISTS _incomplete)
                message(STATUS "  ${_name} is still not provisioned")
            endforeach()
            opendcc_deps_die("dependency prefix is incomplete: ${DEPS_PREFIX}")
        endif()
    endif()
    message(STATUS "")
    message(STATUS "dependency prefix is ready: ${DEPS_PREFIX}")
endfunction()
